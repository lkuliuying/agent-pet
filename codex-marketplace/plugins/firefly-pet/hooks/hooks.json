{
  "description": "Windows 本地状态播报；只发送事件类型及会话、轮次标识，不返回审批决定。",
  "hooks": {
    "Stop": [{ "hooks": [{
      "type": "command",
      "command": "echo {}",
      "commandWindows": "cmd.exe /d /c \"${PLUGIN_ROOT}\\hooks\\notify.cmd\"",
      "async": true,
      "timeout": 2
    }] }],
    "PermissionRequest": [{ "hooks": [{
      "type": "command",
      "command": "echo {}",
      "commandWindows": "cmd.exe /d /c \"${PLUGIN_ROOT}\\hooks\\notify.cmd\"",
      "async": true,
      "timeout": 2
    }] }],
    "Interrupt": [{ "hooks": [{
      "type": "command",
      "command": "echo {}",
      "commandWindows": "cmd.exe /d /c \"${PLUGIN_ROOT}\\hooks\\notify.cmd\"",
      "async": true,
      "timeout": 2
    }] }]
  }
}
