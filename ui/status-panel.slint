import { ScrollView } from "std-widgets.slint";
import { PetTheme, ActionButton, Icon } from "controls.slint";
import { SessionRow, SessionList } from "session-list.slint";

export struct QuotaRow { title: string, remaining: string, reset: string }

component StatusChip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    border-color: #cdded5; border-width: 1px; border-radius: 7px;
    background: #f7faf8;
    HorizontalLayout {
        padding-left: 5px; padding-right: 5px; spacing: 3px;
        Text { text: root.label; color: PetTheme.muted; font-size: 12px; vertical-alignment: center; }
        Text { text: root.value; color: PetTheme.ink; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-alignment: right; }
    }
}

export component StatusPanelWindow inherits Window {
    title: "流萤桌宠 · 当前状态";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 352px;
    height: root.details-open ? 40px + min(400px, 218px + root.rows.length * 72px + root.sessions.length * 82px) : 32px;
    default-font-family: "Microsoft YaHei UI";
    in property <string> cpu-text: "未知";
    in property <string> memory-text: "未知";
    in property <string> gpu-text: "未知";
    in property <string> quota-text: "未查询";
    in property <[QuotaRow]> rows;
    in property <[SessionRow]> sessions;
    in property <string> session-status: "正在读取本机会话…";
    in property <string> status: "正在后台同步额度…";
    in property <string> updated;
    in property <bool> busy;
    in-out property <bool> details-open: false;
    callback dismiss();
    callback refresh();
    callback toggle-details();
    toggle-details => { root.details-open = !root.details-open; }

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 32px;
        HorizontalLayout {
            spacing: 4px;
            StatusChip { width: 72px; label: "CPU"; value: root.cpu-text; }
            StatusChip { width: 72px; label: "内存"; value: root.memory-text; }
            StatusChip { width: 72px; label: "GPU"; value: root.gpu-text; }
            Rectangle {
                width: 124px;
                border-color: #cdded5; border-width: 1px; border-radius: 7px;
                background: touch.has-hover ? #eaf3ee : #f7faf8;
                accessible-role: button;
                accessible-label: "Codex 剩余额度 " + root.quota-text + "，展开或收起详情";
                accessible-action-default => { root.toggle-details(); }
                HorizontalLayout {
                    padding-left: 8px; padding-right: 6px; spacing: 4px;
                    Text { text: "Codex"; color: PetTheme.muted; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.quota-text; color: PetTheme.ink; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-alignment: right; }
                    Icon { width: 12px; font-size: 10px; color: PetTheme.muted; text: root.details-open ? "\u{e70e}" : "\u{e70d}"; }
                }
                touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-details(); } }
            }
        }
    }
    if root.details-open: Rectangle {
        y: 40px; height: parent.height - 40px;
        background: #f7faf8;
        border-color: #cdded5; border-width: 1px; border-radius: 8px;
        VerticalLayout {
            padding: 12px; spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Codex 额度详情"; color: PetTheme.ink; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                ActionButton { text: root.busy ? "查询中" : "刷新"; enabled: !root.busy; clicked => { root.refresh(); } }
            }
            ScrollView {
                horizontal-stretch: 1; vertical-stretch: 1;
                content-width: self.width;
                VerticalLayout {
                    padding-right: 10px; spacing: 6px;
                    Text { text: root.status; color: PetTheme.muted; font-size: 12px; wrap: word-wrap; }
                    if root.rows.length > 1: Text { text: "小框显示各额度窗口中最低剩余值。"; color: PetTheme.muted; font-size: 11px; wrap: word-wrap; }
                    for row in root.rows: Rectangle {
                        min-height: 66px; max-height: 66px;
                        background: white; border-radius: 6px;
                        VerticalLayout {
                            padding: 6px; spacing: 2px;
                            Text { text: row.title; color: PetTheme.ink; font-size: 12px; overflow: elide; }
                            Text { text: "剩余 " + row.remaining; color: PetTheme.green; font-size: 16px; font-weight: 600; }
                            Text { text: row.reset; color: PetTheme.muted; font-size: 11px; overflow: elide; }
                        }
                    }
                    if root.updated != "": Text { text: root.updated; color: PetTheme.muted; font-size: 11px; wrap: word-wrap; }
                    SessionList { rows: root.sessions; status: root.session-status; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
